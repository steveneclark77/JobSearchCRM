# Export these in the shell that starts the backend. This file is NOT loaded automatically.
# Local H2 defaults require no database configuration.
# DATABASE_URL=jdbc:postgresql://localhost:5432/jobcrm
# DATABASE_USER=jobcrm
# DATABASE_PASSWORD=

# Email is disabled until configured. Use a provider's SMTP credentials/app password.
MAIL_ENABLED=false
# MAIL_FROM=you@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_AUTH=true
# SMTP_STARTTLS=true

# Set true only when serving through HTTPS.
COOKIE_SECURE=false
# BIND_ADDRESS=127.0.0.1
# PORT=8080
# BACKUP_DIR=./data/backups
